# Next.js origin the mobile app calls.
# Physical device: use your computer's LAN IP, e.g. http://192.168.1.10:3000
# Android emulator: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google sign-in (see docs/google-sign-in.md)
# Web OAuth client id: the app asks Google for tokens meant for this client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=310219060303-lt9v8354kuuujh2fja7j3bhqsdc7eelb.apps.googleusercontent.com
# Only needed for iOS builds.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
